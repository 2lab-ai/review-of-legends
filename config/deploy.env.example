# Deployment settings for one host. Copy to config/deploy.env and edit.
# KEY=VALUE lines only: read as data, never executed (no quotes, no $expansion).
# A variable set (non-empty) in the environment wins over this file. Each key once.
# service.sh and scripts/install-dashboard.py read it; see docs/operations.md
# "Deployment settings".

# launchd label of the review daemon (default ai.2lab.review-of-legends)
ROL_SERVICE_LABEL=ai.2lab.review-of-legends
# launchd label of the dashboard (default <ROL_SERVICE_LABEL>.dashboard)
ROL_DASHBOARD_LABEL=ai.2lab.review-of-legends.dashboard

# The one owner address: always admin. Without it the dashboard refuses to start.
ROL_DASHBOARD_OWNER=owner@example.com
# Google Workspace domains whose verified accounts sign in read-only (comma-separated).
ROL_DASHBOARD_VIEWER_DOMAINS=example.com
# The HTTPS origin your reverse proxy serves the dashboard on.
ROL_DASHBOARD_PUBLIC_URL=https://rol.example.com
